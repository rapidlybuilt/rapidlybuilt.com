#!/usr/bin/env bash
set -e

# After Kamal deploys: pull the image we just deployed, extract its assets into
# this repo, then run baking_rack publish so the static site uses the same
# digested assets as the app (no second asset build).

: "${KAMAL_VERSION:?post-deploy: KAMAL_VERSION not set}"

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Read registry server and image name from config/deploy.yml (handles ERB)
read -r KAMAL_REGISTRY_SERVER IMAGE_NAME <<< "$(ruby -ryaml -rerb -e "
  config = YAML.load(ERB.new(File.read('config/deploy.yml')).result(binding))
  puts [config.dig('registry', 'server'), config['image']].join(' ')
")"
: "${KAMAL_REGISTRY_SERVER:?post-deploy: could not read registry.server from config/deploy.yml}"
: "${IMAGE_NAME:?post-deploy: could not read image from config/deploy.yml}"

IMAGE="$KAMAL_REGISTRY_SERVER/$IMAGE_NAME:$KAMAL_VERSION"

echo "Pulling image and extracting assets for Baking Rack..."
docker pull "$IMAGE"
cid=$(docker create "$IMAGE")
mkdir -p public
docker cp "$cid:/rails/public/assets" ./public/
docker rm "$cid"

echo "Publishing static site (Baking Rack)..."
export RAILS_ENV=production
export SECRET_KEY_BASE_DUMMY=1
bundle exec baking_rack publish

echo "Baking Rack publish done (Kamal deploy already finished)."
