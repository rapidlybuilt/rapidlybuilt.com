    <p class="typography-body text-xl text-gray-600 max-w-2xl mx-auto">
      Ruby gems you can install — extracted from real production applications.
    </p>
  </div>

  <%= render_feature_list [
    { name: "Baking Rack →", description: "Renders and deploys Rack apps as static sites.", path: gems_baking_rack_path },
