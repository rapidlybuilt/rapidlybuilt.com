#!/usr/bin/env ruby
# frozen_string_literal: true

package = ARGV.shift

if package.nil?
  puts "Usage: bin/upgrade <package> [options]"
  puts "Example: bin/upgrade ui_docs"
  exit 1
end

package_lib_dir = File.expand_path("../lib/#{package}", __dir__)

unless Dir.exist?(package_lib_dir)
  puts "Error: Package library directory not found: #{package_lib_dir}"
  exit 1
end

upgrade_script = File.join(package_lib_dir, "bin/upgrade")

unless File.exist?(upgrade_script)
  puts "Error: No bin/upgrade found in #{package_lib_dir}"
  exit 1
end

Dir.chdir(package_lib_dir) do
  exec("bin/upgrade", *ARGV)
end
